+// ---------------------------------------------------------------------------------------------
+// Model packet cache. The game's meshes are prebuilt VIF packets in RAM that the frame's DMA chain
+// CALLs (or REFs) once per object: STCYCL/STMASK, UNPACKs into the double buffer, MSCNT, plus a
+// DIRECT GIF packet for the draw state. Such a packet is compiled the second time it is seen with
+// the same bytes: the interpreter runs it twice against probe VU memories filled with 0 and with
+// ~0, and a lane that comes out equal in both is a write (with that value) of the segment before
+// each event. Replaying is then a list of masked 16-byte stores, the GIF submits and the MSCAL /
+// MSCNT callbacks, with the VIF registers set as the interpreter leaves them. A packet is keyed by
+// its address, a hash of its bytes and the VIF state it starts from (cycle, mask, mode, row, col,
+// TOPS/BASE/OFST/DBF, ITOPS). RT_VIFCACHE=0 turns it off; RT_VIFCACHECHECK=1 runs the interpreter
+// alongside each replay on a shadow of VU memory and compares memory, events and registers.
+// ---------------------------------------------------------------------------------------------
+#include <unordered_map>
+#include <deque>
+
+namespace
+{
+    struct VcWrite
+    {
+        __m128i v, m;   // value (already masked) and lane mask
+        uint32_t qw;
+    };
+    struct VcRun
+    {
+        uint32_t qw, n, val;
+    };
+    struct VcEvent
+    {
+        uint32_t kind, a, b, top, itop, tops, dbf, wEnd, rEnd;   // kind 0 GIF (a = payload offset, b = bytes), 1 MSCAL (a = pc), 2 MSCNT
+    };
+    struct VcKey
+    {
+        uint32_t cycle, mask, mode, itops, base, ofst, tops, dbf, row[4], col[4], tte;
+        bool operator==(const VcKey &o) const { return std::memcmp(this, &o, sizeof(VcKey)) == 0; }
+    };
+    struct VcPacket
+    {
+        uint64_t hash = 0, serial = 0;
+        VcKey key{};
+        bool bad = false;
+        std::vector<VcRun> runs;      // whole qwords: copied from vals
+        std::vector<__m128i> vals;
+        std::vector<VcWrite> w;       // qwords with some lanes kept
+        std::vector<VcEvent> ev;
+        VIFRegisters fin{};
+    };
+    struct VcSlot
+    {
+        std::deque<VcPacket> v;
+        uint64_t lastHash = 0;
+        uint32_t seen = 0, rehash = 0;
+        bool dynamic = false;
+    };
+
+    uint64_t vcHash(const uint8_t *tte, const uint8_t *p, uint32_t n)
+    {
+        // Eight independent multiply-rotate chains, one per word of a 64-byte block (n is a multiple of 16).
+        uint64_t h[8];
+        for (int k = 0; k < 8; ++k)
+            h[k] = 0x9E3779B97F4A7C15ull * (k + 1) ^ n;
+        if (tte)
+        {
+            uint64_t t;
+            std::memcpy(&t, tte, 8);
+            h[0] ^= t;
+        }
+        auto mix = [](uint64_t x, uint64_t v) { x = (x ^ v) * 0x87C37B91114253D5ull; return (x << 31) | (x >> 33); };
+        uint32_t i = 0;
+        for (; i + 64u <= n; i += 64u)
+        {
+            uint64_t v[8];
+            std::memcpy(v, p + i, 64);
+            for (int k = 0; k < 8; ++k)
+                h[k] = mix(h[k], v[k]);
+        }
+        for (int k = 0; i + 8u <= n; i += 8u, ++k)
+        {
+            uint64_t v;
+            std::memcpy(&v, p + i, 8);
+            h[k] = mix(h[k], v);
+        }
+        uint64_t r = 0;
+        for (int k = 0; k < 8; ++k)
+            r = (r ^ h[k]) * 0xC2B2AE3D27D4EB4Full + (r >> 29);
+        return r;
+    }
+
+    struct VcCur
+    {
+        uint32_t r = 0, w = 0;
+    };
+    // The packet's writes up to an event (rEnd/wEnd), or to the end.
+    void vcApply(uint8_t *vu, const VcPacket &p, VcCur &c, uint32_t rEnd, uint32_t wEnd)
+    {
+        for (; c.r < rEnd; ++c.r)
+        {
+            const VcRun &r = p.runs[c.r];
+            std::memcpy(vu + r.qw * 16u, p.vals.data() + r.val, r.n * 16u);
+        }
+        for (; c.w < wEnd; ++c.w)
+        {
+            const VcWrite &w = p.w[c.w];
+            __m128i *d = reinterpret_cast<__m128i *>(vu + w.qw * 16u);
+            _mm_storeu_si128(d, _mm_or_si128(_mm_andnot_si128(w.m, _mm_loadu_si128(d)), w.v));
+        }
+    }
+    void vcApplyAll(uint8_t *vu, const VcPacket &p, VcCur &c)
+    {
+        vcApply(vu, p, c, static_cast<uint32_t>(p.runs.size()), static_cast<uint32_t>(p.w.size()));
+    }}
+
+struct PS2Memory::Vif1Recorder
+{
+    bool bad = false, check = false;
+    uint32_t fill = 0;
+    std::vector<std::vector<uint8_t>> snaps;
+    std::vector<VcEvent> ev;
+    // check mode
+    const VcPacket *pkt = nullptr;
+    const uint8_t *data = nullptr;
+    uint32_t tteLen = 0;
+    uint8_t *real = nullptr;
+    size_t idx = 0;
+    VcCur cur;
+    uint64_t mismatches = 0;
+};
+
+struct PS2Memory::Vif1PacketCache
+{
+    std::unordered_map<uint32_t, VcSlot> slots;
+    uint64_t replays = 0, compiles = 0, bad = 0, interp = 0, checks = 0, checkBad = 0, bytes = 0;
+};
+
+void PS2Memory::vif1RecEvent(uint32_t kind, uint32_t a, uint32_t b, uint32_t top, uint32_t itop)
+{
+    Vif1Recorder &r = *m_vif1Rec;
+    if (kind == 3u)
+    {
+        r.bad = true;
+        return;
+    }
+    const VcEvent e{kind, a, b, top, itop, vif1_regs.tops, vif1_regs.stat & 0x80u, 0u};
+    if (!r.check)
+    {
+        r.ev.push_back(e);
+        r.snaps.emplace_back(m_vu1Data, m_vu1Data + PS2_VU1_DATA_SIZE);
+        std::memset(m_vu1Data, static_cast<int>(r.fill & 0xFFu), PS2_VU1_DATA_SIZE);
+        return;
+    }
+    // Check: bring the real memory to this event with the cached writes, compare with the
+    // interpreter's shadow, then do the event for real.
+    uint8_t *shadow = m_vu1Data;
+    const VcPacket &p = *r.pkt;
+    bool ok = r.idx < p.ev.size();
+    if (ok)
+    {
+        const VcEvent &c = p.ev[r.idx];
+        vcApply(r.real, p, r.cur, c.rEnd, c.wEnd);
+        ok = c.kind == kind && c.a + (kind == 0u ? r.tteLen : 0u) == a && c.b == b && c.top == top && c.itop == itop &&
+             c.tops == e.tops && c.dbf == e.dbf && std::memcmp(r.real, shadow, PS2_VU1_DATA_SIZE) == 0;
+    }
+    if (!ok && r.mismatches++ < 8)
+        std::fprintf(stderr, "[vifcache] CHECK MISMATCH at event %zu (kind %u)\n", r.idx, kind);
+    ++r.idx;
+    m_vu1Data = r.real;
+    m_vif1Rec = nullptr;
+    if (kind == 0u)
+        submitGifPacket(GifPathId::Path2, r.data + a, b, true, false);
+    else if (kind == 1u && m_vu1MscalCallback)
+        m_vu1MscalCallback(a, top, itop);
+    else if (kind == 2u && m_vu1MscntCallback)
+        m_vu1MscntCallback(top, itop);
+    m_vif1Rec = &r;
+    m_vu1Data = shadow;
+    std::memcpy(shadow, r.real, PS2_VU1_DATA_SIZE);
+}
+
+bool PS2Memory::replayVif1Packet(const uint8_t *tte, uint32_t phys, uint32_t bytes)
+{
+    static const bool off = std::getenv("RT_VIFCACHE") && std::atoi(std::getenv("RT_VIFCACHE")) == 0;
+    static const bool checkMode = std::getenv("RT_VIFCACHECHECK") != nullptr;
+    if (off || !m_vu1Data || m_vif1Rec || m_vif1Stalled || !m_vif1Carry.empty() || m_vif1PendingPath2ImageQwc != 0u ||
+        bytes < 256u || phys + bytes > PS2_RAM_SIZE)
+        return false;
+    if (!m_vif1Cache)
+        m_vif1Cache = new Vif1PacketCache();
+    Vif1PacketCache &C = *m_vif1Cache;
+    const uint8_t *src = m_rdram + phys;
+    VcSlot &slot = C.slots[phys];
+    if (slot.dynamic)
+        return false;
+    static const bool timing = std::getenv("RT_VIFCACHETIME") != nullptr;
+    static uint64_t tHash = 0, tApply = 0, tN = 0, tW = 0;
+    uint64_t t0 = timing ? __rdtsc() : 0;
+    const uint64_t h = vcHash(tte, src, bytes);
+    if (timing)
+        tHash += __rdtsc() - t0;
+    VcKey key{};
+    key.cycle = vif1_regs.cycle, key.mask = vif1_regs.mask, key.mode = vif1_regs.mode, key.itops = vif1_regs.itops;
+    key.base = vif1_regs.base, key.ofst = vif1_regs.ofst, key.tops = vif1_regs.tops, key.dbf = vif1_regs.stat & 0x80u;
+    std::memcpy(key.row, vif1_regs.row, 16);
+    std::memcpy(key.col, vif1_regs.col, 16);
+    key.tte = tte ? 1u : 0u;
+
+    const VcPacket *pk = nullptr;
+    for (const VcPacket &p : slot.v)
+        if (p.hash == h && p.key == key)
+            pk = &p;
+    if (!pk)
+    {
+        if (slot.lastHash != h)
+        {
+            if (slot.seen && ++slot.rehash > 16u)
+            {
+                slot.dynamic = true;   // rewritten every frame or so: not a model packet
+                slot.v.clear();
+            }
+            slot.lastHash = h;
+            slot.seen = 1;
+            ++C.interp;
+            return false;
+        }
+        if (++slot.seen < 2u)
+        {
+            ++C.interp;
+            return false;
+        }
+        // Compile: two interpreter runs on probe memories.
+        const uint32_t tteLen = tte ? 8u : 0u;
+        std::vector<uint8_t> buf(tteLen + bytes);
+        if (tte)
+            std::memcpy(buf.data(), tte, 8);
+        std::memcpy(buf.data() + tteLen, src, bytes);
+        const VIFRegisters saved = vif1_regs;
+        uint8_t *realVu = m_vu1Data;
+        std::vector<uint8_t> probe(PS2_VU1_DATA_SIZE);
+        Vif1Recorder run[2];
+        VIFRegisters fin[2];
+        for (int k = 0; k < 2; ++k)
+        {
+            run[k].fill = k ? 0xFFFFFFFFu : 0u;
+            std::memset(probe.data(), k ? 0xFF : 0, probe.size());
+            m_vu1Data = probe.data();
+            m_vif1Rec = &run[k];
+            processVIF1Data(buf.data(), static_cast<uint32_t>(buf.size()));
+            run[k].snaps.emplace_back(probe.begin(), probe.end());
+            fin[k] = vif1_regs;
+            vif1_regs = saved;
+        }
+        m_vif1Rec = nullptr;
+        m_vu1Data = realVu;
+        VcPacket p;
+        static uint64_t serials = 0;
+        p.serial = ++serials;
+        p.hash = h;
+        p.key = key;
+        p.fin = fin[0];
+        p.bad = run[0].bad || run[1].bad || run[0].ev.size() != run[1].ev.size() || !m_vif1Carry.empty() ||
+                std::memcmp(&fin[0], &fin[1], sizeof(VIFRegisters)) != 0;
+        for (size_t e = 0; !p.bad && e < run[0].ev.size(); ++e)
+        {
+            const VcEvent &x = run[0].ev[e], &y = run[1].ev[e];
+            p.bad = x.kind != y.kind || x.a != y.a || x.b != y.b || x.top != y.top || x.itop != y.itop || (x.kind == 0u && x.a < tteLen);
+        }
+        m_vif1Carry.clear();
+        if (!p.bad)
+        {
+            for (size_t s = 0; s < run[0].snaps.size(); ++s)
+            {
+                const uint32_t *A = reinterpret_cast<const uint32_t *>(run[0].snaps[s].data());
+                const uint32_t *B = reinterpret_cast<const uint32_t *>(run[1].snaps[s].data());
+                const size_t runsAtSeg = p.runs.size();
+                for (uint32_t q = 0; q < PS2_VU1_DATA_SIZE / 16u; ++q)
+                {
+                    alignas(16) uint32_t v[4], m[4];
+                    bool any = false;
+                    for (int l = 0; l < 4; ++l)
+                    {
+                        const bool wr = A[q * 4 + l] == B[q * 4 + l];
+                        m[l] = wr ? 0xFFFFFFFFu : 0u;
+                        v[l] = wr ? A[q * 4 + l] : 0u;
+                        any |= wr;
+                    }
+                    const __m128i vv = _mm_load_si128(reinterpret_cast<const __m128i *>(v));
+                    if (any && (m[0] & m[1] & m[2] & m[3]))
+                    {
+                        if (p.runs.empty() || p.runs.size() == runsAtSeg || p.runs.back().qw + p.runs.back().n != q)
+                            p.runs.push_back(VcRun{q, 0u, static_cast<uint32_t>(p.vals.size())});
+                        ++p.runs.back().n;
+                        p.vals.push_back(vv);
+                    }
+                    else if (any)
+                        p.w.push_back(VcWrite{vv, _mm_load_si128(reinterpret_cast<const __m128i *>(m)), q});
+                }
+                if (s < run[0].ev.size())
+                {
+                    VcEvent e = run[0].ev[s];
+                    if (e.kind == 0u)
+                        e.a -= tteLen;
+                    e.wEnd = static_cast<uint32_t>(p.w.size());
+                    e.rEnd = static_cast<uint32_t>(p.runs.size());
+                    p.ev.push_back(e);
+                }
+            }
+        }
+        ++C.compiles;
+        if (p.bad)
+            ++C.bad;
+        if (slot.v.size() >= 4u)
+            slot.v.pop_front();
+        slot.v.push_back(std::move(p));
+        pk = &slot.v.back();
+    }
+    if (pk->bad)
+    {
+        ++C.interp;
+        return false;
+    }
+    ++C.replays;
+    C.bytes += bytes;
+    slot.rehash = 0;
+    if (checkMode)
+    {
+        const uint32_t tteLen = tte ? 8u : 0u;
+        std::vector<uint8_t> buf(tteLen + bytes);
+        if (tte)
+            std::memcpy(buf.data(), tte, 8);
+        std::memcpy(buf.data() + tteLen, src, bytes);
+        std::vector<uint8_t> shadow(m_vu1Data, m_vu1Data + PS2_VU1_DATA_SIZE);
+        Vif1Recorder r;
+        r.check = true, r.pkt = pk, r.data = buf.data(), r.tteLen = tteLen, r.real = m_vu1Data;
+        m_vu1Data = shadow.data();
+        m_vif1Rec = &r;
+        processVIF1Data(buf.data(), static_cast<uint32_t>(buf.size()));
+        m_vif1Rec = nullptr;
+        m_vu1Data = r.real;
+        vcApplyAll(r.real, *pk, r.cur);
+        const bool regsOk = vif1_regs.cycle == pk->fin.cycle && vif1_regs.mask == pk->fin.mask && vif1_regs.mode == pk->fin.mode &&
+                            vif1_regs.tops == pk->fin.tops && vif1_regs.top == pk->fin.top && vif1_regs.itop == pk->fin.itop &&
+                            vif1_regs.itops == pk->fin.itops && vif1_regs.base == pk->fin.base && vif1_regs.ofst == pk->fin.ofst &&
+                            (vif1_regs.stat & 0x80u) == (pk->fin.stat & 0x80u) && vif1_regs.code == pk->fin.code &&
+                            std::memcmp(vif1_regs.row, pk->fin.row, 16) == 0 && std::memcmp(vif1_regs.col, pk->fin.col, 16) == 0;
+        const bool ok = r.mismatches == 0 && !r.bad && r.idx == pk->ev.size() && regsOk &&
+                        std::memcmp(r.real, shadow.data(), PS2_VU1_DATA_SIZE) == 0;
+        ++C.checks;
+        if (!ok && C.checkBad++ < 20)
+            std::fprintf(stderr, "[vifcache] CHECK FAIL packet %08x (%u bytes): events %zu/%zu regs %d\n", phys, bytes, r.idx, pk->ev.size(), regsOk ? 1 : 0);
+        if ((C.checks & 0x3FFFu) == 0u)
+            std::fprintf(stderr, "[vifcache] %llu replays checked, %llu differ\n", (unsigned long long)C.checks, (unsigned long long)C.checkBad);
+        return true;
+    }
+    VcCur cur;
+    if (timing && (++tN & 0x3FFFu) == 0u)
+        std::fprintf(stderr, "[vifcache] per replay: hash %llu ticks, writes %llu ticks (%llu writes, %llu bytes)\n", (unsigned long long)(tHash / tN),
+                     (unsigned long long)(tApply / tN), (unsigned long long)(tW / tN), (unsigned long long)(C.bytes / C.replays));
+    tW += pk->vals.size() + pk->w.size();
+    for (const VcEvent &e : pk->ev)
+    {
+        t0 = timing ? __rdtsc() : 0;
+        vcApply(m_vu1Data, *pk, cur, e.rEnd, e.wEnd);
+        if (timing)
+            tApply += __rdtsc() - t0;
+        if (e.kind == 0u)
+        {
+            submitGifPacket(GifPathId::Path2, src + e.a, e.b, true, false);
+            continue;
+        }
+        vif1_regs.top = e.top;
+        vif1_regs.itop = e.itop;
+        vif1_regs.tops = e.tops;
+        vif1_regs.stat = (vif1_regs.stat & ~0x80u) | e.dbf;
+        ps2x_capture::g_vif1BatchId = (pk->serial << 16) | static_cast<uint64_t>(&e - pk->ev.data() + 1);
+        if (e.kind == 1u && m_vu1MscalCallback)
+            m_vu1MscalCallback(e.a, e.top, e.itop);
+        else if (e.kind == 2u && m_vu1MscntCallback)
+            m_vu1MscntCallback(e.top, e.itop);
+        ps2x_capture::g_vif1BatchId = 0;

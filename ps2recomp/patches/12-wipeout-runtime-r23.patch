+// A model batch for the GPU transform (GSModelPacket): PRE/PRIM applied, then the backend draws
+// it with the current draw state.
+bool GS::tryProcessNativeModelPacket(const uint8_t *data, uint32_t sizeBytes)
+{
+    if (sizeBytes < sizeof(GSModelPacket) || loadLE64(data) != kGsModelMagic)
+        return false;
+    GSModelPacket m;
+    std::memcpy(&m, data, sizeof(m));
+    if (sizeBytes < sizeof(m) + m.dataBytes)
+        return true;
+    m_curQ = 1.0f;
+    if ((m.tag[0] >> 46) & 1)
+        writeRegisterUnlocked(GS_REG_PRIM, (m.tag[0] >> 47) & 0x7FF);
+    GSPrimitiveBatch batch = buildDrawBatch(0);
+    updatePreferredDisplaySourceForDraw(batch);
+    if (m_backend)
+        m_backend->SubmitModel(batch.state, m, data + sizeof(m), m_curFog);
+    m_vtxCount = 0;
+    return true;
+}

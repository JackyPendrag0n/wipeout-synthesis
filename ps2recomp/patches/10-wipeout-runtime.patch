+// Bytes of data that follow VIFcode `cmd` in the stream (0 for codes without data).
+static uint32_t vif1CommandDataBytes(uint32_t cmd, uint32_t cycle)
+{
+    const uint32_t opcode = (cmd >> 24) & 0x7Fu;
+    const uint32_t imm = cmd & 0xFFFFu;
+    const uint32_t num = (cmd >> 16) & 0xFFu;
+    if (opcode == VIF_STMASK)
+        return 4u;
+    if (opcode == VIF_STROW || opcode == VIF_STCOL)
+        return 16u;
+    if (opcode == VIF_MPG)
+        return (num == 0u ? 256u : num) * 8u;
+    if (opcode == VIF_DIRECT || opcode == VIF_DIRECTHL)
+        return (imm == 0u ? 65536u : imm) * 16u;
+    if ((opcode & 0x60u) == 0x60u)
+    {
+        const uint32_t vn = (opcode >> 2) & 3u, vl = opcode & 3u;
+        static const uint32_t bits[4] = {32u, 16u, 8u, 16u};
+        const uint32_t bitsPerVector = (vl == 3u && vn == 3u) ? 16u : (vn + 1u) * bits[vl];
+        const uint32_t bytesPerVector = (bitsPerVector + 7u) / 8u;
+        const uint32_t writes = num == 0u ? 256u : num;
+        uint32_t cl = cycle & 0xFFu, wl = (cycle >> 8) & 0xFFu;
+        if (cl == 0u) cl = 1u;
+        if (wl == 0u) wl = 1u;
+        uint32_t sources = writes;
+        if (cl < wl)
+        {
+            uint32_t rem = writes % wl;
+            if (rem > cl) rem = cl;
+            sources = (writes / wl) * cl + rem;
+        }
+        return (sources * bytesPerVector + 3u) & ~3u;
+    }
+    return 0u;
+}

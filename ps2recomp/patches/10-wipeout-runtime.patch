+            updatePreferredDisplaySourceForDraw(batch);
+            if (m_prim.type != GS_PRIM_SPRITE)
+                break;
+        }
+        m_backend->SubmitList(batch.state, m_nativeList.data(), prims, static_cast<uint32_t>(needed));
+    }
+    return true;
+}

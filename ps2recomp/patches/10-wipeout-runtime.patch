diff --git a/ps2xIOP/src/emulator/native/iop_aot.cpp b/ps2xIOP/src/emulator/native/iop_aot.cpp
new file mode 100644
index 0000000..bdfc581
--- /dev/null
+++ b/ps2xIOP/src/emulator/native/iop_aot.cpp
@@ -0,0 +1,74 @@
+#include "iop_aot.h"
+
+#include <cstring>
+
+namespace ps2x::iop::detail::aot
+{
+    namespace
+    {
+        // The .text section of an IRX image (file offset, size).
+        bool FindText(std::span<const uint8_t> img, uint32_t &off, uint32_t &size)
+        {
+            auto r32 = [&](size_t a) { uint32_t v = 0; if (a + 4 <= img.size()) std::memcpy(&v, img.data() + a, 4); return v; };
+            auto r16 = [&](size_t a) { uint16_t v = 0; if (a + 2 <= img.size()) std::memcpy(&v, img.data() + a, 2); return v; };
+            if (img.size() < 0x34 || std::memcmp(img.data(), "\x7F" "ELF", 4) != 0)
+                return false;
+            const uint32_t shoff = r32(0x20), shnum = r16(0x30), shstr = r16(0x32);
+            const uint32_t strOff = r32(shoff + shstr * 40u + 16u);
+            for (uint32_t i = 0; i < shnum; ++i)
+            {
+                const size_t sh = shoff + i * 40u;
+                const uint32_t name = strOff + r32(sh);
+                if (name + 6 <= img.size() && std::memcmp(img.data() + name, ".text", 6) == 0)
+                {
+                    off = r32(sh + 16u);
+                    size = r32(sh + 20u);
+                    return r32(sh + 12u) == 0 && off + size <= img.size();
+                }
+            }
+            return false;
+        }
+    }
+
+    const Module *findModule(std::span<const uint8_t> image)
+    {
+        uint32_t off = 0, size = 0;
+        if (!FindText(image, off, size))
+            return nullptr;
+        uint32_t h = 0x811C9DC5u;
+        for (uint32_t i = 0; i + 4 <= size; i += 4)
+        {
+            uint32_t w;
+            std::memcpy(&w, image.data() + off + i, 4);
+            const uint32_t op = w >> 26;
+            w &= op == 0 ? 0xFFFFFFFFu : op == 2 || op == 3 ? 0xFC000000u : 0xFFFF0000u;
+            for (int b = 0; b < 4; ++b)
+                h = (h ^ ((w >> (8 * b)) & 0xFFu)) * 0x01000193u;
+        }
+        for (size_t i = 0; i < kAotModuleCount; ++i)
+            if (kAotModules[i].textSize == size && kAotModules[i].hash == h)
+                return &kAotModules[i];
+        return nullptr;
+    }
+
+    uint64_t run(const Module &m, uint32_t base, IopCpuState &cpu, IopMemory &mem, uint64_t limit)
+    {
+        const uint32_t *code = reinterpret_cast<const uint32_t *>(mem.ram().data() + (base & (IopMemory::RamSize - 1u)));
+        Ctx c{cpu, mem, code, base, 0, limit};
+        while (c.n < c.limit)
+        {
+            const uint32_t off = cpu.pc - base;
+            if (off >= m.textSize || (off & 3u))
+                break;
+            const int16_t f = m.entry[off >> 2];
+            if (f < 0)
+                break;
+            const uint64_t before = c.n;
+            m.fns[f](c, off);
+            cpu.gpr[0] = 0;
+            if (c.n == before && cpu.pc - base == off)
+                break;   // the block starts with something left to the interpreter
+        }
+        return c.n;
+    }
+}
diff --git a/ps2xIOP/src/emulator/native/iop_aot.h b/ps2xIOP/src/emulator/native/iop_aot.h
new file mode 100644
index 0000000..fd3fe13
--- /dev/null
+++ b/ps2xIOP/src/emulator/native/iop_aot.h
@@ -0,0 +1,119 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+#include "../core/iop_cpu.h"
+#include "../core/iop_memory.h"
+
+// IOP modules translated ahead of time into C++ (iopxlat.py, run by the port's setup.sh).
+// A translated module runs natively from any of its entry points (function entries, branch
+// targets, call returns) until control leaves what the translation covers: calls, returns,
+// imports and anything it left to the interpreter. Guest registers and memory stay exactly as
+// the interpreter would leave them, and each block adds its guest instruction count, so the
+// IOP's timing is unchanged.
+namespace ps2x::iop::detail::aot
+{
+    struct Ctx
+    {
+        IopCpuState &cpu;
+        IopMemory &mem;
+        const uint32_t *code;   // the module's loaded (relocated) code
+        uint32_t base;
+        uint64_t n = 0;       // guest instructions executed
+        uint64_t limit = 0;   // backward branches leave once n reaches this
+    };
+    using Fn = void (*)(Ctx &, uint32_t off);
+
+    struct Module
+    {
+        const char *name;
+        uint32_t textSize;
+        uint32_t hash;          // FNV-1a of .text with relocatable fields masked
+        const int16_t *entry;   // per text word: index into fns of the function with that entry point, or -1
+        const Fn *fns;
+    };
+
+    extern const Module kAotModules[];
+    extern const size_t kAotModuleCount;
+
+    // The translated module matching an IRX image (by its .text), or nullptr.
+    const Module *findModule(std::span<const uint8_t> image);
+
+    // Run natively from cpu.pc while it is at an entry point of m (loaded at base); returns the
+    // guest instructions executed (0 when cpu.pc is not an entry point).
+    uint64_t run(const Module &m, uint32_t base, IopCpuState &cpu, IopMemory &mem, uint64_t limit);
+
+    inline void Mult(Ctx &c, uint32_t a, uint32_t b)
+    {
+        const int64_t p = static_cast<int64_t>(static_cast<int32_t>(a)) * static_cast<int32_t>(b);
+        c.cpu.lo = static_cast<uint32_t>(p);
+        c.cpu.hi = static_cast<uint32_t>(static_cast<uint64_t>(p) >> 32);
+    }
+    inline void Multu(Ctx &c, uint32_t a, uint32_t b)
+    {
+        const uint64_t p = static_cast<uint64_t>(a) * b;
+        c.cpu.lo = static_cast<uint32_t>(p);
+        c.cpu.hi = static_cast<uint32_t>(p >> 32);
+    }
+    inline void Div(Ctx &c, uint32_t a, uint32_t b)
+    {
+        const int32_t l = static_cast<int32_t>(a), r = static_cast<int32_t>(b);
+        if (r == 0)
+        {
+            c.cpu.lo = l >= 0 ? 0xFFFFFFFFu : 1u;
+            c.cpu.hi = a;
+        }
+        else if (l == INT32_MIN && r == -1)
+        {
+            c.cpu.lo = a;
+            c.cpu.hi = 0;
+        }
+        else
+        {
+            c.cpu.lo = static_cast<uint32_t>(l / r);
+            c.cpu.hi = static_cast<uint32_t>(l % r);
+        }
+    }
+    inline void Divu(Ctx &c, uint32_t a, uint32_t b)
+    {
+        if (b == 0)
+        {
+            c.cpu.lo = 0xFFFFFFFFu;
+            c.cpu.hi = a;
+        }
+        else
+        {
+            c.cpu.lo = a / b;
+            c.cpu.hi = a % b;
+        }
+    }
+    // Unaligned loads/stores, as the interpreter does them (little-endian R3000).
+    inline uint32_t Lwl(Ctx &c, uint32_t addr, uint32_t old)
+    {
+        static constexpr uint32_t masks[4] = {0x00FFFFFFu, 0x0000FFFFu, 0x000000FFu, 0x00000000u};
+        static constexpr uint32_t shifts[4] = {24u, 16u, 8u, 0u};
+        return (old & masks[addr & 3u]) | (c.mem.read32(addr & ~3u) << shifts[addr & 3u]);
+    }
+    inline uint32_t Lwr(Ctx &c, uint32_t addr, uint32_t old)
+    {
+        static constexpr uint32_t masks[4] = {0x00000000u, 0xFF000000u, 0xFFFF0000u, 0xFFFFFF00u};
+        static constexpr uint32_t shifts[4] = {0u, 8u, 16u, 24u};
+        return (old & masks[addr & 3u]) | (c.mem.read32(addr & ~3u) >> shifts[addr & 3u]);
+    }
+    inline void Swl(Ctx &c, uint32_t addr, uint32_t v)
+    {
+        const uint32_t a = addr & ~3u, old = c.mem.read32(a);
+        static constexpr uint32_t keep[4] = {0xFFFFFF00u, 0xFFFF0000u, 0xFF000000u, 0x00000000u};
+        static constexpr uint32_t shifts[4] = {24u, 16u, 8u, 0u};
+        c.mem.write32(a, (old & keep[addr & 3u]) | (v >> shifts[addr & 3u]));
+    }
+    inline void Swr(Ctx &c, uint32_t addr, uint32_t v)
+    {
+        const uint32_t a = addr & ~3u, old = c.mem.read32(a);
+        static constexpr uint32_t keep[4] = {0x00000000u, 0x000000FFu, 0x0000FFFFu, 0x00FFFFFFu};
+        static constexpr uint32_t shifts[4] = {0u, 8u, 16u, 24u};
+        c.mem.write32(a, (old & keep[addr & 3u]) | (v << shifts[addr & 3u]));
+    }
+}

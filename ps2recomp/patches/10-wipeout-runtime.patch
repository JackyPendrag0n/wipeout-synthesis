+        {
+        case GS_PRIM_TRISTRIP:
+            m_vtxQueue[0] = m_vtxQueue[1];
+            m_vtxQueue[1] = m_vtxQueue[2];
+            m_vtxCount = 2;
+            break;
+        case GS_PRIM_TRIFAN:

+    // Runs the server's function (fno, buf, size) as a guest invocation, the same way
+    // sceSifExecRequest would on the server thread, then hands back its return buffer.
+    bool callEeRpcServer(uint8_t *rdram, PS2Runtime *runtime, uint32_t sid, uint32_t function,
+                         const uint8_t *send, uint32_t sendSize, uint32_t receiveSize,
+                         std::function<void(const uint8_t *result, uint32_t size)> done)
+    {

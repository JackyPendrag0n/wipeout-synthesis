+            break;
+        default:
+            m_vtxCount = 0;
+            break;
+        }
+    }
+    if (list && !m_nativeList.empty())
+    {
+        const uint32_t prims = static_cast<uint32_t>(m_nativeList.size()) / static_cast<uint32_t>(needed);
+        GSPrimitiveBatch batch = buildDrawBatch(0);
+        batch.vertexCount = static_cast<uint8_t>(needed);
+        for (uint32_t i = 0; i < prims; ++i)
+        {
+            // Only sprites can change the preferred display source; for the rest one call does it.
+            for (int v = 0; v < needed; ++v)

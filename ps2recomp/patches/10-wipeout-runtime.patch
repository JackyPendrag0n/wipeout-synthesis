+            auto it = g_rpc_servers.find(sid);
+            if (it == g_rpc_servers.end())
+                return false;
+            sdPtr = it->second.sd_ptr;
+        }
+        const t_SifRpcServerData *sd = reinterpret_cast<const t_SifRpcServerData *>(getMemPtr(rdram, sdPtr));
+        if (!sd || sd->func == 0u || !runtime->hasFunction(sd->func))
+            return false;
+        if (sendSize && sd->buf)
+        {
+            uint8_t *buf = getMemPtr(rdram, sd->buf);
+            uint8_t *last = getMemPtr(rdram, sd->buf + sendSize - 1u);
+            if (!buf || !last || last - buf != static_cast<ptrdiff_t>(sendSize - 1u))
+                return false;
+            std::memcpy(buf, send, sendSize);
+        }
+
+        GuestInvocation invocation{};
+        invocation.kind = GuestInvocationKind::RpcCallback;
+        invocation.tag = sid;
+        invocation.context = runtime->cpu();
+        invocation.context.pc = sd->func;
+        SET_GPR_U32(&invocation.context, 4, function);
+        SET_GPR_U32(&invocation.context, 5, sd->buf);
+        SET_GPR_U32(&invocation.context, 6, sendSize);
+        SET_GPR_U32(&invocation.context, 7, 0u);
+        SET_GPR_U32(&invocation.context, 29, 0u);
+        SET_GPR_U32(&invocation.context, 31, 0u);
+        invocation.onComplete = [rdram, receiveSize, done = std::move(done)](const R5900Context &result, R5900Context &)
+        {
+            const uint32_t ret = getRegU32(&result, 2);
+            const uint8_t *data = (ret && receiveSize) ? getMemPtr(rdram, ret) : nullptr;
+            done(data, data ? receiveSize : 0u);
+        };
+        runtime->eeScheduler().queueInvocation(std::move(invocation));
+        return true;
+    }
 }

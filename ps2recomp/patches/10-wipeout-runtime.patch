+        const bool ok = m_impl->pumpThreads([this, sid] { return m_impl->rpc.hasServer(sid); }, kIopClockHz / 10u);
+        if (!ok)
+            m_impl->rpcWaitFailed.insert(sid);   // nothing serves it: don't wait again
+        return ok;
     }
 

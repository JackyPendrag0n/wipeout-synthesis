+// EE I/O registers by address: a flat table for the 0x10000000..0x1000FFFF words the game reads
+// and writes all the time, a map for anything else (same interface as the map it replaces).
+class IoRegisterFile
+{
+public:
+    struct Ref
+    {
+        uint32_t *v;
+        uint32_t &second;   // the register itself (writes go through)
+        Ref *operator->() { return this; }
+        const Ref *operator->() const { return this; }
+        bool operator!=(const Ref &o) const { return v != o.v; }
+        bool operator==(const Ref &o) const { return v == o.v; }
+    };
+    size_t count(uint32_t a) const
+    {
+        if (flat(a)) return m_present[idx(a)];
+        return m_other.count(a);
+    }
+    uint32_t &operator[](uint32_t a)
+    {
+        if (flat(a)) { m_present[idx(a)] = 1; return m_vals[idx(a)]; }
+        return m_other[a];
+    }
+    Ref find(uint32_t a)
+    {
+        if (flat(a))
+            return m_present[idx(a)] ? Ref{&m_vals[idx(a)], m_vals[idx(a)]} : end();
+        auto it = m_other.find(a);
+        return it == m_other.end() ? end() : Ref{&it->second, it->second};
+    }
+    Ref end() { return Ref{nullptr, m_none}; }
+    void clear()
+    {
+        std::fill(std::begin(m_present), std::end(m_present), 0);
+        std::fill(std::begin(m_vals), std::end(m_vals), 0u);
+        m_other.clear();
+    }
+
+private:
+    static bool flat(uint32_t a) { return (a & 0xFFFF0003u) == 0x10000000u; }
+    static uint32_t idx(uint32_t a) { return (a & 0xFFFFu) >> 2; }
+    uint32_t m_vals[0x4000] = {};
+    uint8_t m_present[0x4000] = {};
+    std::unordered_map<uint32_t, uint32_t> m_other;
+    uint32_t m_none = 0;
+};

diff --git a/ps2xIOP/include/ps2x/iop/iop_audio.h b/ps2xIOP/include/ps2x/iop/iop_audio.h
new file mode 100644
index 0000000..be54f0c
--- /dev/null
+++ b/ps2xIOP/include/ps2x/iop/iop_audio.h
@@ -0,0 +1,98 @@
+#pragma once
+// SPU2 output ring: the IOP's SPU2 (emulated time) pushes 48 kHz stereo frames, the host audio
+// callback (recomp/rufftrigger_audio.cpp) pulls them. Nothing is queued until a consumer enables
+// output, and the ring keeps at most kAudioRingFrames (the oldest frames are dropped), so a
+// consumer that falls behind does not build up latency.
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+#include <vector>
+
+namespace ps2x::iop
+{
+    inline constexpr uint32_t kAudioRate = 48000u;
+    inline constexpr size_t kAudioRingFrames = 32768u;   // ~680 ms
+
+    namespace detail
+    {
+        struct AudioRing
+        {
+            std::mutex mutex;
+            std::vector<int16_t> buf = std::vector<int16_t>(kAudioRingFrames * 2u);
+            size_t read = 0, count = 0;   // in frames
+            bool enabled = false;
+        };
+        inline AudioRing g_audioRing;
+    }
+
+    inline void enableAudioOutput(bool on)
+    {
+        std::lock_guard<std::mutex> lock(detail::g_audioRing.mutex);
+        detail::g_audioRing.enabled = on;
+        if (!on)
+            detail::g_audioRing.read = detail::g_audioRing.count = 0;
+    }
+
+    inline bool audioOutputEnabled()
+    {
+        std::lock_guard<std::mutex> lock(detail::g_audioRing.mutex);
+        return detail::g_audioRing.enabled;
+    }
+
+    // Producer: interleaved stereo frames.
+    inline void pushAudio(const int16_t *frames, size_t n)
+    {
+        auto &r = detail::g_audioRing;
+        std::lock_guard<std::mutex> lock(r.mutex);
+        if (!r.enabled)
+            return;
+        if (n > kAudioRingFrames)
+        {
+            frames += (n - kAudioRingFrames) * 2u;
+            n = kAudioRingFrames;
+        }
+        if (r.count + n > kAudioRingFrames)
+        {
+            const size_t drop = r.count + n - kAudioRingFrames;
+            r.read = (r.read + drop) % kAudioRingFrames;
+            r.count -= drop;
+        }
+        size_t w = (r.read + r.count) % kAudioRingFrames;
+        for (size_t left = n; left > 0;)
+        {
+            const size_t chunk = std::min(left, kAudioRingFrames - w);
+            std::memcpy(&r.buf[w * 2u], frames, chunk * 4u);
+            frames += chunk * 2u;
+            left -= chunk;
+            w = (w + chunk) % kAudioRingFrames;
+        }
+        r.count += n;
+    }
+
+    // Consumer: returns the number of frames copied (the rest of out is left untouched).
+    inline size_t readAudio(int16_t *out, size_t n)
+    {
+        auto &r = detail::g_audioRing;
+        std::lock_guard<std::mutex> lock(r.mutex);
+        n = std::min(n, r.count);
+        for (size_t left = n; left > 0;)
+        {
+            const size_t chunk = std::min(left, kAudioRingFrames - r.read);
+            std::memcpy(out, &r.buf[r.read * 2u], chunk * 4u);
+            out += chunk * 2u;
+            left -= chunk;
+            r.read = (r.read + chunk) % kAudioRingFrames;
+        }
+        r.count -= n;
+        return n;
+    }
+
+    inline size_t queuedAudioFrames()
+    {
+        std::lock_guard<std::mutex> lock(detail::g_audioRing.mutex);
+        return detail::g_audioRing.count;
+    }
+}

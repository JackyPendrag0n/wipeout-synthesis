diff --git a/ps2xIOP/src/emulator/core/iop_spu2.cpp b/ps2xIOP/src/emulator/core/iop_spu2.cpp
new file mode 100644
index 0000000..3d87c61
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_spu2.cpp
@@ -0,0 +1,576 @@
+#include "iop_spu2.h"
+
+#include "ps2x/iop/iop_audio.h"
+
+#include <algorithm>
+#include <cstring>
+
+namespace ps2x::iop
+{
+    namespace
+    {
+        // Register offsets inside a core (core 1 = +0x400).
+        constexpr uint32_t kVoiceRegs = 0x000;    // 24 x 0x10: VOLL VOLR PITCH ADSR1 ADSR2 ENVX VOLXL VOLXR
+        constexpr uint32_t kPmon = 0x180, kNon = 0x184, kVmixl = 0x188, kVmixel = 0x18C, kVmixr = 0x190,
+                           kVmixer = 0x194, kMmix = 0x198, kAttr = 0x19A, kIrqaH = 0x19C, kIrqaL = 0x19E,
+                           kKon = 0x1A0, kKoff = 0x1A4, kTsaH = 0x1A8, kTsaL = 0x1AA, kData = 0x1AC,
+                           kAdmas = 0x1B0;
+        constexpr uint32_t kVoiceAddr = 0x1C0;    // 24 x 0xC: SSA LSAX NAX (hi, lo)
+        constexpr uint32_t kEndx = 0x340, kStatx = 0x344;
+        // Shared area.
+        constexpr uint32_t kMvol = 0x760;         // core c: 0x760 + c * 0x28 (MVOLL, MVOLR)
+        constexpr uint32_t kIrqInfo = 0x7C2;
+
+        constexpr int kFilter[5][2] = {{0, 0}, {60, 0}, {115, -52}, {98, -55}, {122, -60}};
+        constexpr uint32_t kAddrMask = Spu2::RamWords - 1u;
+        constexpr size_t kAdmaMax = 48000u;       // one second per channel
+
+        int16_t clamp16(int32_t v) { return static_cast<int16_t>(std::clamp(v, -32768, 32767)); }
+        uint32_t hiLo(uint16_t hi, uint16_t lo) { return ((static_cast<uint32_t>(hi & 0xFu) << 16) | lo) & kAddrMask; }
+        void setBits(uint32_t &mask, bool high, uint16_t v)
+        {
+            mask = high ? (mask & 0xFFFFu) | (static_cast<uint32_t>(v & 0xFFu) << 16) : (mask & 0xFF0000u) | v;
+        }
+    }
+
+    Spu2::Spu2() : m_ram(RamWords) { reset(); }
+
+    void Spu2::reset()
+    {
+        std::fill(m_ram.begin(), m_ram.end(), 0);
+        std::memset(m_regs, 0, sizeof(m_regs));
+        for (auto &c : m_core)
+            c = Core{};
+        m_irqInfo = 0;
+        m_irqPending = false;
+        m_out.clear();
+    }
+
+    int32_t Spu2::volumeOf(uint16_t reg)
+    {
+        // Sweep mode: the sweep's end value (0 for a decreasing sweep, full scale otherwise).
+        if (reg & 0x8000u)
+        {
+            if (reg & 0x2000u)
+                return 0;
+            return (reg & 0x1000u) ? -0x8000 : 0x7FFF;
+        }
+        return static_cast<int16_t>(reg << 1);
+    }
+
+    void Spu2::raiseIrq(int c)
+    {
+        m_irqInfo |= static_cast<uint16_t>(4u << c);
+        m_irqPending = true;
+    }
+
+    // IRQA is hit by any access to sound RAM, whichever core makes it.
+    void Spu2::checkIrq(uint32_t addr, uint32_t words)
+    {
+        for (int i = 0; i < 2; i++)
+            if ((m_core[i].attr & 0x40u) && ((m_core[i].irqa - addr) & kAddrMask) < words)
+                raiseIrq(i);
+    }
+
+    void Spu2::checkIrqExact(uint32_t addr)
+    {
+        for (int i = 0; i < 2; i++)
+            if ((m_core[i].attr & 0x40u) && m_core[i].irqa == addr)
+                raiseIrq(i);
+    }
+
+    // Moves voice v to its next ADPCM block and decodes it. False when the voice stopped.
+    bool Spu2::fetchBlock(int c, int n)
+    {
+        Voice &v = m_core[c].voices[n];
+        uint32_t addr;
+        if (v.needFetch)
+        {
+            v.needFetch = false;
+            addr = v.ssa & 0xFFFF8u;
+        }
+        else if (v.blockFlags & 1)
+        {
+            m_core[c].endx |= 1u << n;
+            addr = v.lsax;
+            if (!(v.blockFlags & 2))
+            {
+                v.blockAddr = addr;
+                v.phase = Voice::Phase::Off;
+                v.env = 0;
+                v.nax = addr;
+                return false;
+            }
+        }
+        else
+            addr = (v.blockAddr + 8u) & kAddrMask;
+
+        v.blockAddr = addr;
+        checkIrq(addr, 8);
+        const uint16_t head = m_ram[addr];
+        int shift = head & 0xF;
+        if (shift > 12)
+            shift = 9;
+        const int filter = std::min((head >> 4) & 7, 4);
+        v.blockFlags = head >> 8;
+        if (v.blockFlags & 4)
+            v.lsax = addr;
+        const int f0 = kFilter[filter][0], f1 = kFilter[filter][1];
+        for (int i = 0; i < 28; i++)
+        {
+            const uint16_t w = m_ram[(addr + 1u + static_cast<uint32_t>(i >> 2)) & kAddrMask];
+            int32_t s = static_cast<int16_t>(((w >> ((i & 3) * 4)) & 0xF) << 12) >> shift;
+            s += (v.prev1 * f0 + v.prev2 * f1 + 32) >> 6;
+            s = clamp16(s);
+            v.prev2 = v.prev1;
+            v.prev1 = s;
+            v.block[i] = static_cast<int16_t>(s);
+        }
+        v.sampleIndex = 0;
+        return true;
+    }
+
+    void Spu2::keyOn(int c, int n)
+    {
+        Voice &v = m_core[c].voices[n];
+        v.needFetch = true;
+        v.nax = v.blockAddr = v.ssa;
+        v.sampleIndex = 28;   // the first sample step fetches the block at SSA
+        v.blockFlags = 0;
+        v.prev1 = v.prev2 = 0;
+        v.counter = 0;
+        v.last = v.cur = 0;
+        v.phase = Voice::Phase::Attack;
+        v.env = 0;
+        v.envWait = 0;
+        m_core[c].endx &= ~(1u << n);
+    }
+
+    void Spu2::envelopeTick(Voice &v)
+    {
+        using P = Voice::Phase;
+        bool exp = false, dec = false;
+        int shift = 0, step = 0;
+        switch (v.phase)
+        {
+        case P::Off:
+            return;
+        case P::Attack:
+            exp = v.adsr1 & 0x8000u;
+            shift = (v.adsr1 >> 10) & 0x1F;
+            step = 7 - ((v.adsr1 >> 8) & 3);
+            break;
+        case P::Decay:
+            exp = dec = true;
+            shift = ((v.adsr1 >> 4) & 0xF) * 4;
+            step = -8;
+            break;
+        case P::Sustain:
+            exp = v.adsr2 & 0x8000u;
+            dec = v.adsr2 & 0x4000u;
+            shift = (v.adsr2 >> 8) & 0x1F;
+            step = dec ? ((v.adsr2 >> 6) & 3) - 8 : 7 - ((v.adsr2 >> 6) & 3);
+            break;
+        case P::Release:
+            exp = (v.adsr2 >> 5) & 1u;
+            dec = true;
+            shift = (v.adsr2 & 0x1F) * 4;
+            step = -8;
+            break;
+        }
+
+        if (v.envWait > 0 && --v.envWait != 0)
+            return;
+        int32_t cycles = 1;
+        int32_t delta = step;
+        if (shift > 11)
+            cycles = 1 << (shift - 11);
+        else
+            delta = step * (1 << (11 - shift));
+        if (exp && !dec && v.env > 0x6000)
+            cycles *= 4;
+        if (exp && dec)
+            delta = delta * v.env / 0x8000;
+        v.envWait = cycles;
+        const int32_t sum = v.env + delta;
+        v.env = std::clamp(sum, 0, 0x7FFF);
+
+        switch (v.phase)
+        {
+        case P::Attack:
+            if (sum > 0x7FFE)
+            {
+                v.phase = P::Decay;
+                v.envWait = 0;
+            }
+            break;
+        case P::Decay:
+            if ((v.env >> 11) <= static_cast<int32_t>(v.adsr1 & 0xFu))
+            {
+                v.phase = P::Sustain;
+                v.envWait = 0;
+            }
+            break;
+        case P::Release:
+            if (sum <= 0)
+                v.phase = P::Off;
+            break;
+        default:
+            break;
+        }
+    }
+
+    int32_t Spu2::voiceSample(int c, int n)
+    {
+        Core &core = m_core[c];
+        Voice &v = core.voices[n];
+        if (v.phase == Voice::Phase::Off)
+        {
+            v.out = 0;
+            return 0;
+        }
+
+        uint32_t step = std::min<uint32_t>(v.pitch, 0x3FFFu);
+        if (n > 0 && (core.pmon & (1u << n)))
+        {
+            const int64_t mod = static_cast<int64_t>(core.voices[n - 1].out) + 0x8000;
+            step = static_cast<uint32_t>(std::min<int64_t>((mod * step) >> 15, 0x3FFF));
+        }
+        v.counter += step;
+        while (v.counter >= 0x1000u)
+        {
+            v.counter -= 0x1000u;
+            if (v.sampleIndex > 27 && !fetchBlock(c, n))
+            {
+                v.out = 0;
+                return 0;
+            }
+            v.last = v.cur;
+            v.cur = v.block[v.sampleIndex++];
+        }
+        // NAX: the word holding the sample being played.
+        v.nax = (v.blockAddr + 1u + (static_cast<uint32_t>(std::max(v.sampleIndex - 1, 0)) >> 2)) & kAddrMask;
+
+        envelopeTick(v);
+        const int32_t s = v.last + (((v.cur - v.last) * static_cast<int32_t>(v.counter)) >> 12);
+        v.out = (s * v.env) >> 15;
+        return v.out;
+    }
+
+    void Spu2::run(uint32_t samples)
+    {
+        m_out.resize(static_cast<size_t>(samples) * 2u);
+        for (uint32_t i = 0; i < samples; i++)
+        {
+            int32_t mix[2][2] = {};
+            for (int c = 0; c < 2; c++)
+            {
+                Core &core = m_core[c];
+                for (int n = 0; n < 24; n++)
+                {
+                    Voice &v = core.voices[n];
+                    const int32_t s = voiceSample(c, n);
+                    if (core.vmixl & (1u << n))
+                    {
+                        const int32_t vol = volumeOf(v.volL);
+                        v.volXL = static_cast<int16_t>(vol >> 1);
+                        mix[c][0] += (s * vol) >> 15;
+                    }
+                    if (core.vmixr & (1u << n))
+                    {
+                        const int32_t vol = volumeOf(v.volR);
+                        v.volXR = static_cast<int16_t>(vol >> 1);
+                        mix[c][1] += (s * vol) >> 15;
+                    }
+                }
+                if ((core.admas & (1u << c)) && core.admaHead + 1u < core.adma.size())
+                {
+                    mix[c][0] += core.adma[core.admaHead];
+                    mix[c][1] += core.adma[core.admaHead + 1u];
+                    core.admaHead += 2u;
+                    if (core.admaHead >= core.adma.size())
+                    {
+                        core.adma.clear();
+                        core.admaHead = 0;
+                    }
+                }
+            }
+            // Core 0's output goes through its master volume into core 1's mix.
+            const int32_t l0 = (clamp16(mix[0][0]) * volumeOf(m_core[0].mvolL)) >> 15;
+            const int32_t r0 = (clamp16(mix[0][1]) * volumeOf(m_core[0].mvolR)) >> 15;
+            const int32_t l = (clamp16(mix[1][0] + l0) * volumeOf(m_core[1].mvolL)) >> 15;
+            const int32_t r = (clamp16(mix[1][1] + r0) * volumeOf(m_core[1].mvolR)) >> 15;
+            m_out[i * 2u] = clamp16(l);
+            m_out[i * 2u + 1u] = clamp16(r);
+        }
+        pushAudio(m_out.data(), samples);
+    }
+
+    bool Spu2::takeIrq()
+    {
+        const bool p = m_irqPending;
+        m_irqPending = false;
+        return p;
+    }
+
+    uint16_t Spu2::read16(uint32_t address)
+    {
+        const uint32_t off = (address - RegBase) & 0x7FEu;
+        if (off == kIrqInfo)
+        {
+            const uint16_t v = m_irqInfo;
+            m_irqInfo = 0;
+            return v;
+        }
+        if (off >= 0x760u)
+        {
+            for (int c = 0; c < 2; c++)
+            {
+                const uint32_t b = kMvol + static_cast<uint32_t>(c) * 0x28u;
+                if (off == b)
+                    return m_core[c].mvolL;
+                if (off == b + 2u)
+                    return m_core[c].mvolR;
+            }
+            return raw(off);
+        }
+
+        const int c = off >= 0x400u ? 1 : 0;
+        const uint32_t r = off & 0x3FFu;
+        Core &core = m_core[c];
+        if (r < 0x180u)
+        {
+            const Voice &v = core.voices[r >> 4];
+            switch (r & 0xFu)
+            {
+            case 0x0: return v.volL;
+            case 0x2: return v.volR;
+            case 0x4: return v.pitch;
+            case 0x6: return v.adsr1;
+            case 0x8: return v.adsr2;
+            case 0xA: return static_cast<uint16_t>(v.env);
+            case 0xC: return static_cast<uint16_t>(v.volXL);
+            case 0xE: return static_cast<uint16_t>(v.volXR);
+            }
+        }
+        if (r >= kVoiceAddr && r < kVoiceAddr + 24u * 0xCu)
+        {
+            const uint32_t rel = r - kVoiceAddr;
+            const Voice &v = core.voices[rel / 0xCu];
+            uint32_t a = 0;
+            switch ((rel % 0xCu) / 4u)
+            {
+            case 0: a = v.ssa; break;
+            case 1: a = v.lsax; break;
+            default: a = v.nax; break;
+            }
+            return (rel & 2u) ? static_cast<uint16_t>(a) : static_cast<uint16_t>(a >> 16);
+        }
+        switch (r)
+        {
+        case kPmon: return static_cast<uint16_t>(core.pmon);
+        case kPmon + 2: return static_cast<uint16_t>(core.pmon >> 16);
+        case kNon: return static_cast<uint16_t>(core.non);
+        case kNon + 2: return static_cast<uint16_t>(core.non >> 16);
+        case kVmixl: return static_cast<uint16_t>(core.vmixl);
+        case kVmixl + 2: return static_cast<uint16_t>(core.vmixl >> 16);
+        case kVmixel: return static_cast<uint16_t>(core.vmixel);
+        case kVmixel + 2: return static_cast<uint16_t>(core.vmixel >> 16);
+        case kVmixr: return static_cast<uint16_t>(core.vmixr);
+        case kVmixr + 2: return static_cast<uint16_t>(core.vmixr >> 16);
+        case kVmixer: return static_cast<uint16_t>(core.vmixer);
+        case kVmixer + 2: return static_cast<uint16_t>(core.vmixer >> 16);
+        case kMmix: return core.mmix;
+        case kAttr: return core.attr;
+        case kIrqaH: return static_cast<uint16_t>(core.irqa >> 16);
+        case kIrqaL: return static_cast<uint16_t>(core.irqa);
+        case kKon: case kKon + 2: case kKoff: case kKoff + 2: return 0;
+        case kTsaH: return static_cast<uint16_t>(core.tsa >> 16);
+        case kTsaL: return static_cast<uint16_t>(core.tsa);
+        case kData:
+        {
+            const uint16_t v = m_ram[core.tsa];
+            checkIrqExact(core.tsa);
+            core.tsa = (core.tsa + 1u) & kAddrMask;
+            return v;
+        }
+        case kAdmas: return core.admas;
+        case kEndx: return static_cast<uint16_t>(core.endx);
+        case kEndx + 2: return static_cast<uint16_t>(core.endx >> 16);
+        case kStatx: return core.statx;
+        default: return raw(off);
+        }
+    }
+
+    void Spu2::write16(uint32_t address, uint16_t value)
+    {
+        const uint32_t off = (address - RegBase) & 0x7FEu;
+        raw(off) = value;
+        if (off == kIrqInfo)
+        {
+            m_irqInfo = 0;
+            return;
+        }
+        if (off >= 0x760u)
+        {
+            for (int c = 0; c < 2; c++)
+            {
+                const uint32_t b = kMvol + static_cast<uint32_t>(c) * 0x28u;
+                if (off == b)
+                    m_core[c].mvolL = value;
+                else if (off == b + 2u)
+                    m_core[c].mvolR = value;
+            }
+            return;
+        }
+
+        const int c = off >= 0x400u ? 1 : 0;
+        const uint32_t r = off & 0x3FFu;
+        Core &core = m_core[c];
+        if (r < 0x180u)
+        {
+            Voice &v = core.voices[r >> 4];
+            switch (r & 0xFu)
+            {
+            case 0x0: v.volL = value; break;
+            case 0x2: v.volR = value; break;
+            case 0x4: v.pitch = value; break;
+            case 0x6: v.adsr1 = value; break;
+            case 0x8: v.adsr2 = value; break;
+            case 0xA: v.env = value & 0x7FFF; break;
+            case 0xC: v.volXL = static_cast<int16_t>(value); break;
+            case 0xE: v.volXR = static_cast<int16_t>(value); break;
+            default: break;
+            }
+            return;
+        }
+        if (r >= kVoiceAddr && r < kVoiceAddr + 24u * 0xCu)
+        {
+            const uint32_t rel = r - kVoiceAddr;
+            Voice &v = core.voices[rel / 0xCu];
+            uint32_t *a = nullptr;
+            switch ((rel % 0xCu) / 4u)
+            {
+            case 0: a = &v.ssa; break;
+            case 1: a = &v.lsax; break;
+            default: a = &v.nax; break;
+            }
+            if (rel & 2u)
+                *a = (*a & 0xF0000u) | value;
+            else
+                *a = ((static_cast<uint32_t>(value & 0xFu) << 16) | (*a & 0xFFFFu));
+            *a &= kAddrMask;
+            return;
+        }
+        switch (r)
+        {
+        case kPmon: case kPmon + 2: setBits(core.pmon, r & 2u, value); break;
+        case kNon: case kNon + 2: setBits(core.non, r & 2u, value); break;
+        case kVmixl: case kVmixl + 2: setBits(core.vmixl, r & 2u, value); break;
+        case kVmixel: case kVmixel + 2: setBits(core.vmixel, r & 2u, value); break;
+        case kVmixr: case kVmixr + 2: setBits(core.vmixr, r & 2u, value); break;
+        case kVmixer: case kVmixer + 2: setBits(core.vmixer, r & 2u, value); break;
+        case kMmix: core.mmix = value; break;
+        case kAttr:
+            core.attr = value;
+            if (!(value & 0x40u))
+                m_irqInfo &= static_cast<uint16_t>(~(4u << c));
+            break;
+        case kIrqaH: core.irqa = hiLo(value, static_cast<uint16_t>(core.irqa)); break;
+        case kIrqaL: core.irqa = hiLo(static_cast<uint16_t>(core.irqa >> 16), value); break;
+        case kKon:
+        case kKon + 2:
+        {
+            const int base = (r & 2u) ? 16 : 0;
+            const int count = (r & 2u) ? 8 : 16;
+            for (int i = 0; i < count; i++)
+                if (value & (1u << i))
+                    keyOn(c, base + i);
+            break;
+        }
+        case kKoff:
+        case kKoff + 2:
+        {
+            const int base = (r & 2u) ? 16 : 0;
+            const int count = (r & 2u) ? 8 : 16;
+            for (int i = 0; i < count; i++)
+                if ((value & (1u << i)) && core.voices[base + i].phase != Voice::Phase::Off)
+                {
+                    core.voices[base + i].phase = Voice::Phase::Release;
+                    core.voices[base + i].envWait = 0;
+                }
+            break;
+        }
+        case kTsaH: core.tsa = hiLo(value, static_cast<uint16_t>(core.tsa)); break;
+        case kTsaL: core.tsa = hiLo(static_cast<uint16_t>(core.tsa >> 16), value); break;
+        case kData:
+            m_ram[core.tsa] = value;
+            checkIrqExact(core.tsa);
+            core.tsa = (core.tsa + 1u) & kAddrMask;
+            break;
+        case kAdmas:
+            core.admas = value;
+            if (value == 0)
+            {
+                core.adma.clear();
+                core.admaHead = 0;
+            }
+            break;
+        case kEndx: core.endx &= 0xFF0000u; break;
+        case kEndx + 2: core.endx &= 0xFFFFu; break;
+        default: break;
+        }
+    }
+
+    uint64_t Spu2::dma(int core, uint8_t *iopRam, uint32_t iopRamSize, uint32_t madr, uint32_t bytes, bool toSpu)
+    {
+        Core &c = m_core[core & 1];
+        madr &= iopRamSize - 1u;
+        bytes = std::min(bytes, iopRamSize - madr);
+        const uint32_t words = bytes / 2u;
+        const uint8_t *src = iopRam + madr;
+
+        if (toSpu && (c.admas & (1u << (core & 1))))
+        {
+            // AutoDMA: 1 KB blocks of 256 left samples then 256 right samples.
+            if (c.admaHead)
+            {
+                c.adma.erase(c.adma.begin(), c.adma.begin() + static_cast<std::ptrdiff_t>(c.admaHead));
+                c.admaHead = 0;
+            }
+            for (uint32_t blk = 0; blk + 0x200u <= words; blk += 0x200u)
+                for (uint32_t i = 0; i < 256u; i++)
+                {
+                    int16_t l, r;
+                    std::memcpy(&l, src + (blk + i) * 2u, 2);
+                    std::memcpy(&r, src + (blk + 256u + i) * 2u, 2);
+                    c.adma.push_back(l);
+                    c.adma.push_back(r);
+                }
+            // Completes when the FIFO is down to 512 frames, so the driver stays one block ahead.
+            const size_t queuedBytes = c.adma.size() * 2u;
+            if (queuedBytes <= 0x802u)
+                return 0x40u;
+            return static_cast<uint64_t>(queuedBytes / 4u) * CyclesPerSample - 512u * CyclesPerSample;
+        }
+
+        checkIrq(c.tsa, words);
+        for (uint32_t i = 0; i < words; i++)
+        {
+            uint16_t w;
+            if (toSpu)
+            {
+                std::memcpy(&w, src + i * 2u, 2);
+                m_ram[(c.tsa + i) & kAddrMask] = w;
+            }
+            else
+            {
+                w = m_ram[(c.tsa + i) & kAddrMask];
+                std::memcpy(iopRam + madr + i * 2u, &w, 2);
+            }
+        }
+        c.tsa = (c.tsa + words) & kAddrMask;
+        c.statx = static_cast<uint16_t>((c.statx & 0xFB7Fu) | 0x80u);
+        return std::max<uint64_t>(words, 0x40u);
+    }
+}
diff --git a/ps2xIOP/src/emulator/core/iop_spu2.h b/ps2xIOP/src/emulator/core/iop_spu2.h
new file mode 100644
index 0000000..bf82e3c
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_spu2.h
@@ -0,0 +1,97 @@
+#pragma once
+// SPU2 (the PS2's sound processor) as the IOP sees it: two cores of 24 ADPCM voices sharing 2 MB
+// of sound RAM, programmed through 16-bit registers at 0x1F900000. The game's sound driver
+// (Sony MultiStream on LIBSD) runs in the IOP interpreter and talks to these registers directly;
+// it also polls voice positions (NAX, ENDX) to pace its streams, so voices must really advance.
+//
+// Emulated: ADPCM decode with loop flags, pitch (0x1000 = 48 kHz) with PMON and linear
+// interpolation, ADSR envelopes (psx-spx rules), KON/KOFF/ENDX, voice and master volumes
+// (sweeps jump to their end value), dry L/R mixing by VMIXL/VMIXR, core 0 feeding core 1,
+// TSA + data port, manual DMA both ways, AutoDMA (ADMA) input, IRQA hits from voice fetches,
+// DMA and the data port (IRQINFO, INTC line 9).
+// Not emulated: reverb, noise, the effect send mix, SPDIF.
+//
+// Output goes to the host through ps2x/iop/iop_audio.h.
+
+#include <cstdint>
+#include <vector>
+
+namespace ps2x::iop
+{
+    class Spu2
+    {
+    public:
+        static constexpr uint32_t RegBase = 0x1F900000u;
+        static constexpr uint32_t RegEnd = 0x1F900800u;
+        static constexpr uint32_t CyclesPerSample = 768u;   // IOP clock 36.864 MHz / 48 kHz
+        static constexpr uint32_t RamWords = 1u << 20;      // 2 MB as 16-bit words
+
+        Spu2();
+        void reset();
+
+        uint16_t read16(uint32_t address);
+        void write16(uint32_t address, uint16_t value);
+
+        // IOP DMA channel 4 (core 0) / 7 (core 1). toSpu: IOP RAM -> SPU2. Returns the IOP cycles
+        // until the transfer completes (AutoDMA data completes as it is played).
+        uint64_t dma(int core, uint8_t *iopRam, uint32_t iopRamSize, uint32_t madr, uint32_t bytes, bool toSpu);
+
+        // Produce this many 48 kHz output samples.
+        void run(uint32_t samples);
+
+        // True once after the SPU2 raised its interrupt.
+        bool takeIrq();
+
+    private:
+        struct Voice
+        {
+            uint16_t volL = 0, volR = 0, pitch = 0, adsr1 = 0, adsr2 = 0;
+            int16_t volXL = 0, volXR = 0;
+            uint32_t ssa = 0, lsax = 0, nax = 0;   // word addresses
+            bool needFetch = false;                // key on: the first block comes from SSA
+            // decoder
+            uint32_t blockAddr = 0;                // word address of the block being played
+            int16_t block[28] = {};
+            int blockFlags = 0;
+            int sampleIndex = 0;
+            int32_t prev1 = 0, prev2 = 0;
+            int16_t cur = 0, last = 0;             // interpolation pair
+            uint32_t counter = 0;
+            // envelope
+            enum class Phase { Off, Attack, Decay, Sustain, Release } phase = Phase::Off;
+            int32_t env = 0;
+            int32_t envWait = 0;
+            int32_t out = 0;                       // last output sample (for PMON)
+        };
+
+        struct Core
+        {
+            Voice voices[24];
+            uint16_t attr = 0, admas = 0, mmix = 0;
+            uint32_t pmon = 0, non = 0, vmixl = 0, vmixr = 0, vmixel = 0, vmixer = 0;
+            uint32_t endx = 0;
+            uint16_t statx = 0;                    // bit 7 set once a manual DMA has completed
+            uint32_t irqa = 0, tsa = 0;
+            uint16_t mvolL = 0, mvolR = 0;
+            std::vector<int16_t> adma;             // AutoDMA input FIFO, interleaved L/R
+            size_t admaHead = 0;
+        };
+
+        static int32_t volumeOf(uint16_t reg);
+        void keyOn(int c, int v);
+        bool fetchBlock(int c, int v);
+        void checkIrq(uint32_t addr, uint32_t words);
+        void checkIrqExact(uint32_t addr);
+        void raiseIrq(int c);
+        int32_t voiceSample(int c, int v);
+        static void envelopeTick(Voice &voice);
+        uint16_t &raw(uint32_t offset) { return m_regs[(offset & 0x7FFu) >> 1]; }
+
+        std::vector<uint16_t> m_ram;
+        uint16_t m_regs[0x400] = {};
+        Core m_core[2];
+        uint16_t m_irqInfo = 0;
+        bool m_irqPending = false;
+        std::vector<int16_t> m_out;
+    };
+}
diff --git a/ps2xIOP/src/emulator/imports/iop_cdvd.cpp b/ps2xIOP/src/emulator/imports/iop_cdvd.cpp
index ad58fb4..63df958 100644
--- a/ps2xIOP/src/emulator/imports/iop_cdvd.cpp
+++ b/ps2xIOP/src/emulator/imports/iop_cdvd.cpp
@@ -1,3 +1,6 @@
+#include <cstdlib>
+#include <cstdio>
+#include <cstdio>
 #include "iop_cdvd.h"
 
 #include "../core/iop_cpu.h"
@@ -228,6 +231,8 @@ namespace ps2x::iop::detail
                 return true;
 
             case 6: // sceCdRead
+                if (std::getenv("IOP_CD_TRACE"))
+                    std::fprintf(stderr, "[iop-cd] read lsn=%u n=%u dst=%06x\n", a0, a1, a2);
                 if (readSectors(a0, a1, a2))
                 {
                     signalCommandComplete();
@@ -594,15 +599,124 @@ namespace ps2x::iop::detail
             return &nodes[current];
         }
 
+        static uint32_t readLe32(const uint8_t *p) { return uint32_t(p[0]) | (uint32_t(p[1]) << 8) | (uint32_t(p[2]) << 16) | (uint32_t(p[3]) << 24); }
+
+        // ISO9660 lookup on the configured disc image, so returned LSNs match the sectors that
+        // readSectors() serves from the same image.
+        bool readImageSector(uint32_t lsn, uint8_t *out)
+        {
+            const std::string imagePath = host.hostPath(HostPathKind::CdImage);
+            if (imagePath.empty())
+                return false;
+            if (imageHandle == 0u)
+                imageHandle = host.openHostFile(imagePath);
+            if (imageHandle == 0u)
+                return false;
+            size_t got = 0u;
+            return host.readHostFile(imageHandle, static_cast<uint64_t>(lsn) * kSectorSize, out, kSectorSize, got) &&
+                   got == kSectorSize;
+        }
+
+        static std::string isoKey(std::string_view name)
+        {
+            std::string out;
+            for (const char c : name)
+            {
+                if (c == ';')
+                    break;
+                out.push_back(static_cast<char>(std::toupper(static_cast<unsigned char>(c))));
+            }
+            if (!out.empty() && out.back() == '.')
+                out.pop_back();
+            return out;
+        }
+
+        bool searchImage(std::string_view guestPath, uint32_t &lsn, uint32_t &size, bool &isDir, std::string &leaf)
+        {
+            std::string path(guestPath);
+            const size_t colon = path.find(':');
+            if (colon != std::string::npos)
+                path = path.substr(colon + 1);
+            std::array<uint8_t, kSectorSize> sector{};
+            if (!readImageSector(16u, sector.data()) || std::memcmp(sector.data() + 1, "CD001", 5) != 0)
+                return false;
+            uint32_t dirLsn = readLe32(sector.data() + 156u + 2u);
+            uint32_t dirSize = readLe32(sector.data() + 156u + 10u);
+            isDir = true;
+            size_t begin = 0;
+            while (begin < path.size())
+            {
+                size_t end = path.find_first_of("\\/", begin);
+                if (end == std::string::npos)
+                    end = path.size();
+                const std::string component = isoKey(std::string_view(path).substr(begin, end - begin));
+                begin = end + 1;
+                if (component.empty())
+                    continue;
+                if (!isDir)
+                    return false;
+                bool found = false;

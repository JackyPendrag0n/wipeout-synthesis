diff --git a/ps2xRuntime/include/runtime/ps2_capture_hook.h b/ps2xRuntime/include/runtime/ps2_capture_hook.h
new file mode 100644
index 0000000..77a0e92
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_capture_hook.h
@@ -0,0 +1,91 @@
+#pragma once
+// Hooks the runtime exposes to game-specific code (recomp/rufftrigger_*.cpp): frame capture,
+// native VU programs, the GPU renderer's present/vblank hooks, debug overlays and pad input.
+// Every hook is a plain function pointer in an atomic; null means "not installed".
+//
+// Display lock: the window thread publishes the time of each host present (g_hostPresentNs) and,
+// while presents are steady at ~60 Hz (or every n-th present on 120/180/240 Hz displays), the
+// display period (g_hostPeriodNs, 0 otherwise). The EE scheduler places each guest vblank a little
+// before the present nearest to its nominal time, so every displayed frame is a new game frame.
+
+#include <atomic>
+#include <cstdint>
+
+namespace ps2x_capture
+{
+    // Capture stream kinds passed to g_hook: VIF1 data as the VIF consumes it, GIF packets by path.
+    enum : uint32_t
+    {
+        Vif1Stream = 0x10u,
+        GifPath1 = 0x11u,
+        GifPath2 = 0x12u,
+        GifPath3 = 0x13u,
+    };
+    using CaptureHook = void (*)(uint32_t kind, const uint8_t *data, uint32_t size);
+    inline std::atomic<CaptureHook> g_hook{nullptr};
+
+    inline void notify(uint32_t kind, const void *data, uint32_t size)
+    {
+        if (auto h = g_hook.load(std::memory_order_relaxed))
+            h(kind, static_cast<const uint8_t *>(data), size);
+    }
+
+    // VU micro programs: called before (and after) each VU1 MSCAL/MSCNT and VU0 CALLMS.
+    enum : uint32_t
+    {
+        Vu1Before = 0u,
+        Vu1After = 1u,
+    };
+    enum : uint32_t
+    {
+        Vu1Mscal = 0u,
+        Vu1Mscnt = 1u,
+        Vu0Callms = 2u,
+    };
+    // Result of a Vu1Before call: run the interpreter from startPC, resume it where it stopped,
+    // or nothing to do (the hook ran the program natively).
+    enum : uint32_t
+    {
+        Vu1Interpret = 0u,
+        Vu1Continue = 1u,
+        Vu1Handled = 2u,
+    };
+    using Vu1HookFn = uint32_t (*)(uint32_t phase, uint32_t kind, uint32_t startPC, uint32_t top, uint32_t itop,
+                                   void *state, uint8_t *vuCode, uint8_t *vuData);
+    inline std::atomic<Vu1HookFn> g_vu1Hook{nullptr};
+
+    // Guest stores through the slow path (scratchpad/MMIO), for debug watches.
+    using StoreHook = void (*)(uint32_t vaddr, uint32_t size, uint64_t lo, uint64_t hi, uint32_t pc, uint32_t ra);
+    inline std::atomic<StoreHook> g_storeHook{nullptr};
+
+    // Window thread, each host frame: draw the game picture into a texture (true) or let the
+    // runtime show its own frame buffer (false).
+    using PresentHook = bool (*)(int screenW, int screenH, uint32_t &tex, uint32_t &w, uint32_t &h);
+    inline std::atomic<PresentHook> g_presentHook{nullptr};
+
+    // Guest vblank start, in order with the GS unit's drawing.
+    using VblankHook = void (*)();
+    inline std::atomic<VblankHook> g_vblankHook{nullptr};
+
+    // Window thread, after the game picture: debug menus and overlays.
+    using OverlayHook = void (*)(int screenW, int screenH);
+    inline std::atomic<OverlayHook> g_overlayHook{nullptr};
+
+    // Pad: buttons (PS2 bit layout, 1 = pressed) added to the host input; g_padBlock reads the
+    // pad as released (debug menu open).
+    using PadHook = uint16_t (*)();
+    inline std::atomic<PadHook> g_padHook{nullptr};
+    inline std::atomic<bool> g_padBlock{false};
+
+    inline std::atomic<int64_t> g_hostPresentNs{0};
+    inline std::atomic<int64_t> g_hostPeriodNs{0};
+
+    // Graphics settings changed at run time (the in-game graphics menu):
+    //   g_displayAspect: how the picture is fitted to the window; 0 = RT_ASPECT/RT_WIDESCREEN as at
+    //     start, > 0 = that width/height, -1 = stretch, -2 = native frame-buffer pixels.
+    //   g_vsyncRequest: -1 = nothing pending, 0/1 = turn display vsync off/on (window thread applies).
+    //   g_eeCyclePct: percent of the EE cycles generated code charges; 0 = RT_EE_CYCLE_PCT (100).
+    inline std::atomic<float> g_displayAspect{0.0f};
+    inline std::atomic<int> g_vsyncRequest{-1};
+    inline std::atomic<uint32_t> g_eeCyclePct{0};
+}

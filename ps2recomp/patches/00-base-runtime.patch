+    // On hybrid CPUs (Intel P/E cores) the game thread can land on an efficiency core and run at
+    // half speed, varying as the OS migrates it. Restrict it to the fastest cores (RT_PIN=0: off).
+    std::vector<int> parseCpuList(const std::string &list)
+    {
+        std::vector<int> cpus;
+        size_t pos = 0;
+        while (pos < list.size())
+        {
+            size_t end = list.find(',', pos);
+            if (end == std::string::npos)
+                end = list.size();
+            const std::string part = list.substr(pos, end - pos);
+            const size_t dash = part.find('-');
+            if (!part.empty() && part[0] >= '0' && part[0] <= '9')
+            {
+                const int a = std::atoi(part.c_str());
+                const int b = dash == std::string::npos ? a : std::atoi(part.c_str() + dash + 1);
+                for (int c = a; c <= b && c < 1024; ++c)
+                    cpus.push_back(c);
+            }
+            pos = end + 1;
+        }
+        return cpus;
+    }
+
+    void pinToFastCores(const char *what)
+    {
+        if (const char *e = std::getenv("RT_PIN"); e && *e && std::atoi(e) == 0)
+            return;
+        std::vector<int> fast;
+        {
+            std::ifstream f("/sys/devices/cpu_core/cpus");   // Intel hybrid: the P-cores
+            std::string line;
+            if (f && std::getline(f, line))
+                fast = parseCpuList(line);
+        }
+        const int total = static_cast<int>(std::thread::hardware_concurrency());
+        if (fast.empty())
+        {
+            // Otherwise: the cores with the highest maximum clock (AMD/ARM big.LITTLE alike).
+            std::vector<long> maxf(total, 0);
+            long best = 0;
+            for (int c = 0; c < total; ++c)
+            {
+                std::ifstream f("/sys/devices/system/cpu/cpu" + std::to_string(c) + "/cpufreq/cpuinfo_max_freq");
+                long v = 0;
+                if (f >> v)
+                    maxf[c] = v;
+                best = std::max(best, v);
+            }
+            if (best > 0)
+                for (int c = 0; c < total; ++c)
+                    if (maxf[c] * 100 >= best * 95)
+                        fast.push_back(c);
+        }
+        if (fast.empty() || static_cast<int>(fast.size()) >= total)
+            return;   // not a hybrid CPU: leave scheduling alone
+        cpu_set_t set;
+        CPU_ZERO(&set);
+        for (int c : fast)
+            CPU_SET(c, &set);
+        if (pthread_setaffinity_np(pthread_self(), sizeof(set), &set) == 0)
+            std::fprintf(stderr, "[rt] %s pinned to the %zu fastest of %d CPUs\n", what, fast.size(), total);
+    }

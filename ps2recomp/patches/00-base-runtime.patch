+void PS2Memory::enableGsAsync(std::function<void()> notify)
+{
+    if (m_gsAsync)
+        return;
+    m_gsNotify = std::move(notify);
+    m_gsStop = false;
+    m_gsThread = std::thread([this]
+                             { gsWorkerLoop(); });
+    m_gsThreadId = m_gsThread.get_id();
+    m_gsAsync = true;
+}
+
+void PS2Memory::gsWorkerLoop()
+{
+    for (;;)
+    {
+        std::function<void()> job;
+        {
+            std::unique_lock<std::mutex> lock(m_gsMutex);
+            m_gsCv.wait(lock, [this]
+                        { return m_gsStop || !m_gsJobs.empty(); });
+            if (m_gsJobs.empty())
+                return;
+            job = std::move(m_gsJobs.front());
+            m_gsJobs.pop_front();
+        }
+        try
+        {
+            job();
+        }
+        catch (const std::exception &e)
+        {
+            std::fprintf(stderr, "[gs-unit] job failed: %s\n", e.what());
+        }
+        bool raised = false;
+        {
+            std::lock_guard<std::mutex> lock(m_completedDmacMutex);
+            raised = !m_pendingIntcCauses.empty() || !m_completedDmacCauses.empty() || !m_asyncDoneChannels.empty();
+        }
+        {
+            std::lock_guard<std::mutex> lock(m_gsMutex);
+            if (m_gsPending.fetch_sub(1u, std::memory_order_acq_rel) == 1u)
+                m_gsIdleCv.notify_all();
+        }
+        if (raised && m_gsNotify)
+            m_gsNotify();
+    }
+}
+
+void PS2Memory::gsPost(std::function<void()> job)
+{
+    if (!m_gsAsync || onGsWorker())
+    {
+        job();
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lock(m_gsMutex);
+        m_gsJobs.push_back(std::move(job));
+        m_gsPending.fetch_add(1u, std::memory_order_acq_rel);
+    }
+    m_gsCv.notify_one();
+}
+
+void PS2Memory::gsDrainSlow()
+{
+    std::unique_lock<std::mutex> lock(m_gsMutex);
+    m_gsIdleCv.wait(lock, [this]
+                    { return m_gsPending.load(std::memory_order_acquire) == 0u; });
+}

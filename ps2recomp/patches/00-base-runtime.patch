+    // Measures the display refresh from the (vsynced) present times and publishes it for the EE
+    // scheduler's vblank placement while it is steady and close to 60 Hz.
+    void publishHostPresent()
+    {
+        using clock = std::chrono::steady_clock;
+        static int64_t last = 0;
+        static double period = 0.0;
+        static int steady = 0;
+        const int64_t now = std::chrono::duration_cast<std::chrono::nanoseconds>(clock::now().time_since_epoch()).count();
+        ps2x_capture::g_hostPresentNs.store(now, std::memory_order_release);
+        if (last != 0)
+        {
+            // On 120/180/240 Hz displays every n-th present is ~16.7 ms apart: lock to that.
+            const double dt0 = static_cast<double>(now - last);
+            const long n = std::lround(16.683e6 / std::max(dt0, 1.0));
+            const double dt = dt0 * static_cast<double>(std::clamp(n, 1L, 4L));
+            if (dt > 15.0e6 && dt < 18.5e6)
+            {
+                period = period == 0.0 ? dt : period * 0.95 + dt * 0.05;
+                steady = std::min(steady + 1, 1000);
+            }
+            else
+                steady = std::max(steady - 20, 0);
+        }
+        // Vsync requested but not honoured (some drivers, remote displays): presents come far
+        // faster than any display refreshes, so fall back to a 60 Hz timer.
+        static int fast = 0;
+        if (g_hostVsync && last != 0 && now - last < 2500000)
+        {
+            if (++fast == 120)
+            {
+                SetTargetFPS(60);
+                g_hostVsync = false;
+                std::fprintf(stderr, "[run] display vsync not in effect; presenting on a 60 Hz timer\n");
+            }
+        }
+        else
+            fast = 0;
+        last = now;
+        static const char *lockEnv = std::getenv("RT_VSYNC_LOCK");
+        static const bool lockOff = lockEnv && *lockEnv && std::strcmp(lockEnv, "0") == 0;
+        static const bool lockForce = lockEnv && std::strcmp(lockEnv, "force") == 0;   // testing on timer presents
+        const bool locked = (g_hostVsync || lockForce) && !lockOff && steady >= 60 && period > 15.4e6 && period < 18.2e6;
+        ps2x_capture::g_hostPeriodNs.store(locked ? static_cast<int64_t>(period) : 0, std::memory_order_release);
+    }
+}
